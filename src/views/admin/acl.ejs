<%- include('../partials/head', { title: 'ACL · Admin' }) %>
<%- include('../partials/adminHeader') %>
<%# Matrix: แถว = permission, คอลัมน์ = role ส่วนจัดการ Role พับไว้ข้างล่าง %>
<main class="container">
  <%- include('../partials/flash') %>
  <h1>ACL</h1>

  <form method="post" action="/admin/roles" class="inline-form" novalidate>
    <div class="field field-narrow">
      <label for="newRoleName">Add Role</label>
      <input id="newRoleName" name="name" type="text" required minlength="2" maxlength="30">
    </div>
    <button type="submit" class="secondary">+ Add Role</button>
  </form>

  <div class="table-wrap section"><table class="matrix">
    <thead>
      <tr>
        <th scope="col">Permission</th>
        <% for (const role of roles) { %><th scope="col" class="matrix-role"><%= role.name %></th><% } %>
      </tr>
    </thead>
    <% for (const group of groups) { %>
      <tbody>
        <tr class="matrix-group">
          <th scope="rowgroup" colspan="<%= roles.length + 1 %>"><%= group.resource.resourceName %> <span class="muted small"><%= group.resource.description %></span></th>
        </tr>
        <% for (const permission of group.permissions) { %>
          <tr id="permission-<%= permission.permissionId %>">
            <th scope="row"><code><%= permission.key %></code> <span class="small muted"><%= permission.description %></span></th>
            <% for (const role of roles) { %>
              <% const granted = isGranted(role, permission); %>
              <td class="matrix-cell">
                <% if (role.isSuperUser) { %>
                  <input type="checkbox" checked disabled aria-label="Admin <%= permission.key %> (always granted)">
                <% } else { %>
                  <%# ติ๊กแล้วส่งฟอร์มเลย (app.js) ถ้าปิด JS ใช้ปุ่มบันทึกใน noscript %>
                  <form method="post" action="/admin/acl/<%= role.roleId %>/<%= permission.permissionId %>" data-autosubmit>
                    <input type="hidden" name="granted" value="<%= granted ? 'false' : 'true' %>">
                    <input type="checkbox"<% if (granted) { %> checked<% } %> aria-label="<%= role.name %> <%= permission.key %>">
                    <noscript><button type="submit" class="link small">Save</button></noscript>
                  </form>
                <% } %>
              </td>
            <% } %>
          </tr>
        <% } %>
      </tbody>
    <% } %>
  </table></div>

  <details class="section" id="roles">
    <summary>Role Management (<%= roles.length %>)</summary>
    <p class="hint">Role ที่ยังมีผู้ใช้ลบไม่ได้</p>
    <table>
      <thead>
        <tr>
          <th scope="col">ID</th>
          <th scope="col">Name</th>
          <th scope="col">Description</th>
          <th scope="col">Users</th>
          <th scope="col"></th>
        </tr>
      </thead>
      <tbody>
        <% for (const role of roles) { %>
          <tr>
            <td><%= role.roleId %></td>
            <td><%= role.name %></td>
            <td><%= role.description %></td>
            <td><% if (role.isGuest) { %>–<% } else { %><a href="/admin/users?roleId=<%= role.roleId %>"><%= role.memberCount %></a><% } %></td>
            <td>
              <% if (!role.isGuest) { %>
                <details>
                  <summary class="small">Edit</summary>
                  <form method="post" action="/admin/roles/<%= role.roleId %>" class="form-narrow" novalidate>
                    <% if (!role.isSystem) { %>
                      <div class="field">
                        <label for="roleName<%= role.roleId %>">Name</label>
                        <input id="roleName<%= role.roleId %>" name="name" type="text" maxlength="30" value="<%= role.name %>">
                      </div>
                    <% } %>
                    <div class="field">
                      <label for="roleDescription<%= role.roleId %>">Description</label>
                      <input id="roleDescription<%= role.roleId %>" name="description" type="text" maxlength="200" value="<%= role.description %>">
                    </div>
                    <button type="submit">Save</button>
                  </form>
                </details>
              <% } %>
              <% if (!role.isSystem) { %>
                <form method="post" action="/admin/roles/<%= role.roleId %>/delete" class="inline" data-confirm="Delete role <%= role.name %>?">
                  <button type="submit" class="link small">Delete</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </details>
</main>
<%- include('../partials/foot') %>
