<%- include('../partials/head', { title: 'Edit profile' }) %>
<%- include('../partials/siteHeader') %>
<main class="container">
  <p class="small"><a href="/app/profile">← Profile</a></p>
  <h1>Edit profile</h1>
  <%- include('../partials/flash') %>

  <section aria-labelledby="accountHeading">
    <h2 id="accountHeading">Account</h2>
    <dl class="meta">
      <dt>Email</dt><dd><%= profile.email %></dd>
      <dt>Username</dt><dd>@<%= profile.username %></dd>
      <dt>Role</dt><dd><%= profile.roleName %></dd>
      <dt>Joined</dt><dd><%= formatDateTime(profile.createdAt) %></dd>
    </dl>
    <% if (me.can('profile.update')) { %>
      <form method="post" action="/app/profile" class="form-narrow" novalidate>
        <div class="field">
          <label for="displayName">Display name</label>
          <input id="displayName" name="displayName" type="text" required minlength="2" maxlength="40" value="<%= profile.displayName %>">
        </div>
        <div class="field">
          <label for="bio">Bio</label>
          <textarea id="bio" name="bio" maxlength="300"><%= profile.bio %></textarea>
        </div>
        <button type="submit">Save</button>
      </form>

      <h3>Avatar</h3>
      <img class="avatar avatar-xl" src="/app/users/<%= me.actor.userId %>/avatar" alt="Current avatar">
      <form method="post" action="/app/profile/avatar" enctype="multipart/form-data" class="inline-form form-narrow" novalidate>
        <div class="field">
          <label for="avatar">Image (jpg, png, webp, max 2 MB)</label>
          <input id="avatar" name="avatar" type="file" accept=".jpg,.jpeg,.png,.webp" required>
        </div>
        <button type="submit">Upload</button>
      </form>
    <% } %>
  </section>

  <% if (me.can('profile.update')) { %>
    <section class="section" aria-labelledby="passwordHeading">
      <h2 id="passwordHeading">Change password</h2>
      <form method="post" action="/app/profile/password" class="form-narrow" novalidate>
        <div class="field">
          <label for="currentPassword">Current password</label>
          <input id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" required>
        </div>
        <div class="field">
          <label for="newPassword">New password</label>
          <input id="newPassword" name="newPassword" type="password" autocomplete="new-password" required>
          <p class="hint">ยาว 8–72 ไบต์</p>
        </div>
        <button type="submit">Change password</button>
      </form>
    </section>
  <% } %>
</main>
<%- include('../partials/foot') %>
